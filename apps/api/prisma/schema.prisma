generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp"), pgcrypto, postgis]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum PlanType {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserType {
  EMPLOYEE
  STUDENT
  CONTRACTOR
  VISITOR
  TENANT_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum GenderType {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum RoleScope {
  GLOBAL
  TENANT
}

enum PolicyEffect {
  ALLOW
  DENY
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  EXPORT
  IMPORT
}

enum AuditStatus {
  SUCCESS
  FAILURE
  PENDING
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Tenant {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String       @db.VarChar(255)
  slug                String       @unique @db.VarChar(100)
  domain              String?      @unique @db.VarChar(255)
  logo                String?      @db.Text
  faviconUrl          String?      @db.Text
  primaryColor        String?      @default("#3B82F6") @db.VarChar(7)
  secondaryColor      String?      @default("#1E40AF") @db.VarChar(7)
  plan                PlanType     @default(FREE)
  status              TenantStatus @default(TRIAL)
  maxUsers            Int          @default(10)
  maxLocations        Int          @default(5)
  contactEmail        String       @db.VarChar(255)
  contactPhone        String?      @db.VarChar(50)
  address             Json?
  timezone            String       @default("UTC") @db.VarChar(100)
  dateFormat          String       @default("YYYY-MM-DD") @db.VarChar(20)
  timeFormat          String       @default("HH:mm") @db.VarChar(10)
  weekStartDay        Int          @default(1)
  currency            String       @default("USD") @db.VarChar(3)
  locale              String       @default("en-US") @db.VarChar(10)
  settings            Json         @default("{}")
  features            Json         @default("{}")
  cognitoUserPoolId   String?      @db.VarChar(100)
  cognitoClientId     String?      @db.VarChar(100)
  cognitoClientSecret String?      @db.Text
  trialEndsAt         DateTime?    @db.Timestamptz
  subscriptionId      String?      @db.VarChar(255)
  billingEmail        String?      @db.VarChar(255)
  metadata            Json         @default("{}")
  createdAt           DateTime     @default(now()) @db.Timestamptz
  updatedAt           DateTime     @updatedAt @db.Timestamptz
  deletedAt           DateTime?    @db.Timestamptz

  users               User[]
  departments         Department[]
  roles               Role[]
  userPolicies        UserPolicy[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  locations           Location[]
  attendanceRecords   AttendanceRecord[]
  attendancePolicy    AttendancePolicy?
  shifts              Shift[]
  shiftAssignments    ShiftAssignment[]
  shiftRotations      ShiftRotation[]

  @@index([slug])
  @@index([status])
  @@index([domain])
  @@map("tenants")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String     @db.Uuid
  email               String     @db.VarChar(255)
  firstName           String     @db.VarChar(100)
  lastName            String     @db.VarChar(100)
  displayName         String?    @db.VarChar(200)
  avatar              String?    @db.Text
  phone               String?    @db.VarChar(50)
  employeeId          String?    @db.VarChar(100)
  userType            UserType   @default(EMPLOYEE)
  status              UserStatus @default(PENDING_VERIFICATION)
  cognitoSub          String?    @unique @db.VarChar(255)
  departmentId        String?    @db.Uuid
  managerId           String?    @db.Uuid
  locationId          String?    @db.Uuid
  timezone            String?    @db.VarChar(100)
  locale              String     @default("en-US") @db.VarChar(10)
  mfaEnabled          Boolean    @default(false)
  mfaSecret           String?    @db.Text
  mfaBackupCodes     String[]   @default([])
  lastLoginAt         DateTime?  @db.Timestamptz
  lastLoginIp         String?    @db.VarChar(45)
  passwordHash        String?    @db.Text
  passwordChangedAt   DateTime?  @db.Timestamptz
  loginAttempts       Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz
  emailVerifiedAt     DateTime?  @db.Timestamptz
  phoneVerifiedAt     DateTime?  @db.Timestamptz
  joinedAt            DateTime?  @db.Timestamptz
  exitedAt            DateTime?  @db.Timestamptz
  metadata            Json       @default("{}")
  createdAt           DateTime   @default(now()) @db.Timestamptz
  updatedAt           DateTime   @updatedAt @db.Timestamptz
  deletedAt           DateTime?  @db.Timestamptz

  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department          Department? @relation(fields: [departmentId], references: [id])
  location            Location?  @relation(fields: [locationId], references: [id])
  manager             User?      @relation("UserManager", fields: [managerId], references: [id])
  subordinates        User[]     @relation("UserManager")
  profile             UserProfile?
  userRoles           UserRole[]
  userPolicies        UserPolicy[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]        @relation("AuditLogUser")
  actedAuditLogs      AuditLog[]        @relation("AuditLogActor")
  attendanceRecords   AttendanceRecord[]
  shiftAssignments    ShiftAssignment[]

  @@unique([tenantId, email])
  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, userType])
  @@index([tenantId, departmentId])
  @@index([cognitoSub])
  @@map("users")
}

// ─── UserProfile ─────────────────────────────────────────────────────────────

model UserProfile {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String     @unique @db.Uuid
  tenantId              String     @db.Uuid
  gender                GenderType?
  dateOfBirth           DateTime?  @db.Date
  nationalId            String?    @db.VarChar(100)
  address               Json?
  emergencyContact      Json?
  bankDetails           String?    @db.Text
  bloodGroup            String?    @db.VarChar(5)
  faceImageUrl          String?    @db.Text
  faceEmbeddingRef      String?    @db.Text
  rfidCardNumber        String?    @db.VarChar(100)
  fingerprintRef        String?    @db.Text
  contractStartDate     DateTime?  @db.Date
  contractEndDate       DateTime?  @db.Date
  probationEndDate      DateTime?  @db.Date
  salary                Decimal?   @db.Decimal(12, 2)
  salaryCurrency        String?    @db.VarChar(3)
  customFields          Json       @default("{}")
  createdAt             DateTime   @default(now()) @db.Timestamptz
  updatedAt             DateTime   @updatedAt @db.Timestamptz

  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("user_profiles")
}

// ─── Department ──────────────────────────────────────────────────────────────

model Department {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String       @db.Uuid
  name            String       @db.VarChar(200)
  code            String?      @db.VarChar(50)
  description     String?      @db.Text
  parentId        String?      @db.Uuid
  headCount       Int          @default(0)
  costCenter      String?      @db.VarChar(100)
  isActive        Boolean      @default(true)
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now()) @db.Timestamptz
  updatedAt       DateTime     @updatedAt @db.Timestamptz
  deletedAt       DateTime?    @db.Timestamptz

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent          Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children        Department[] @relation("DeptHierarchy")
  users           User[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("departments")
}

// ─── Location ────────────────────────────────────────────────────────────────

model Location {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @db.Uuid
  name            String    @db.VarChar(200)
  code            String?   @db.VarChar(50)
  address         Json?
  latitude        Decimal?  @db.Decimal(10, 8)
  longitude       Decimal?  @db.Decimal(11, 8)
  radiusMeters    Int       @default(100)
  timezone        String    @default("UTC") @db.VarChar(100)
  isActive        Boolean   @default(true)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz
  deletedAt       DateTime? @db.Timestamptz

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("locations")
}

// ─── Role ────────────────────────────────────────────────────────────────────

model Role {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String?   @db.Uuid
  name            String    @db.VarChar(100)
  slug            String    @db.VarChar(100)
  description     String?   @db.Text
  scope           RoleScope @default(TENANT)
  isSystem        Boolean   @default(false)
  isDefault       Boolean   @default(false)
  priority        Int       @default(0)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz
  deletedAt       DateTime? @db.Timestamptz

  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([slug])
  @@map("roles")
}

// ─── Permission ──────────────────────────────────────────────────────────────

model Permission {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource        String    @db.VarChar(100)
  action          String    @db.VarChar(100)
  scope           String    @default("tenant") @db.VarChar(50)
  description     String?   @db.Text
  category        String?   @db.VarChar(100)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
  @@index([resource])
  @@index([category])
  @@map("permissions")
}

// ─── RolePermission ──────────────────────────────────────────────────────────

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  conditions   Json?
  grantedBy    String?    @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

// ─── UserRole ────────────────────────────────────────────────────────────────

model UserRole {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  roleId       String    @db.Uuid
  tenantId     String    @db.Uuid
  assignedBy   String?   @db.Uuid
  expiresAt    DateTime? @db.Timestamptz
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([tenantId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── UserPolicy (ABAC) ───────────────────────────────────────────────────────

model UserPolicy {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?      @db.Uuid
  tenantId    String       @db.Uuid
  name        String       @db.VarChar(200)
  description String?      @db.Text
  effect      PolicyEffect @default(ALLOW)
  resources   String[]
  actions     String[]
  conditions  Json?
  priority    Int          @default(0)
  isActive    Boolean      @default(true)
  expiresAt   DateTime?    @db.Timestamptz
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz

  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("user_policies")
}

// ─── RefreshToken ────────────────────────────────────────────────────────────

model RefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  tenantId    String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(255)
  family      String    @db.Uuid
  userAgent   String?   @db.Text
  ipAddress   String?   @db.VarChar(45)
  isRevoked   Boolean   @default(false)
  revokedAt   DateTime? @db.Timestamptz
  revokedReason String? @db.VarChar(100)
  expiresAt   DateTime  @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([family])
  @@map("refresh_tokens")
}

// ─── Attendance Enums ────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_DEPARTURE
  ON_LEAVE
  HOLIDAY
  HALF_DAY
  OVERTIME
}

enum ClockMethod {
  MANUAL
  QR_CODE
  FACE_RECOGNITION
  RFID
  GPS
  KIOSK
  MOBILE
  WEB
}

enum BreakType {
  LUNCH
  SHORT_BREAK
  PRAYER
  MEDICAL
  OTHER
}

// ─── AuditLog ────────────────────────────────────────────────────────────────

model AuditLog {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @db.Uuid
  userId       String?     @db.Uuid
  actorId      String?     @db.Uuid
  action       AuditAction
  resource     String      @db.VarChar(100)
  resourceId   String?     @db.VarChar(255)
  oldValues    Json?
  newValues    Json?
  diff         Json?
  metadata     Json?
  ipAddress    String?     @db.VarChar(45)
  userAgent    String?     @db.Text
  requestId    String?     @db.VarChar(100)
  sessionId    String?     @db.VarChar(255)
  status       AuditStatus @default(SUCCESS)
  errorMessage String?     @db.Text
  duration     Int?
  createdAt    DateTime    @default(now()) @db.Timestamptz

  user         User?       @relation("AuditLogUser", fields: [userId], references: [id])
  actor        User?       @relation("AuditLogActor", fields: [actorId], references: [id])
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, action])
  @@index([tenantId, resource, resourceId])
  @@index([tenantId, userId])
  @@index([tenantId, actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── AttendanceRecord ─────────────────────────────────────────────────────────

model AttendanceRecord {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @db.Uuid
  userId           String           @db.Uuid
  shiftId          String?          @db.Uuid
  locationId       String?          @db.Uuid
  date             DateTime         @db.Date
  scheduledIn      DateTime?        @db.Timestamptz
  scheduledOut     DateTime?        @db.Timestamptz
  clockIn          DateTime?        @db.Timestamptz
  clockOut         DateTime?        @db.Timestamptz
  clockInMethod    ClockMethod?
  clockOutMethod   ClockMethod?
  clockInLat       Decimal?         @db.Decimal(10, 8)
  clockInLng       Decimal?         @db.Decimal(11, 8)
  clockOutLat      Decimal?         @db.Decimal(10, 8)
  clockOutLng      Decimal?         @db.Decimal(11, 8)
  clockInDevice    String?          @db.VarChar(255)
  clockOutDevice   String?          @db.VarChar(255)
  clockInIp        String?          @db.VarChar(45)
  clockOutIp       String?          @db.VarChar(45)
  status           AttendanceStatus @default(PRESENT)
  workMinutes      Int?
  overtimeMinutes  Int?
  breakMinutes     Int              @default(0)
  isLate           Boolean          @default(false)
  lateMinutes      Int              @default(0)
  isEarlyDeparture Boolean          @default(false)
  earlyMinutes     Int              @default(0)
  isManualEntry    Boolean          @default(false)
  manualEntryBy    String?          @db.Uuid
  notes            String?          @db.Text
  approvalStatus   String?          @db.VarChar(50)
  approvedBy       String?          @db.Uuid
  approvedAt       DateTime?        @db.Timestamptz
  metadata         Json             @default("{}")
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @updatedAt @db.Timestamptz

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift            Shift?           @relation(fields: [shiftId], references: [id])
  breaks           AttendanceBreak[]

  @@unique([tenantId, userId, date])
  @@index([tenantId, date])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("attendance_records")
}

// ─── AttendanceBreak ─────────────────────────────────────────────────────────

model AttendanceBreak {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @db.Uuid
  attendanceId    String           @db.Uuid
  breakType       BreakType        @default(SHORT_BREAK)
  startTime       DateTime         @db.Timestamptz
  endTime         DateTime?        @db.Timestamptz
  durationMinutes Int?
  notes           String?          @db.Text
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz

  attendance      AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@index([tenantId])
  @@map("attendance_breaks")
}

// ─── AttendancePolicy ────────────────────────────────────────────────────────

model AttendancePolicy {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @unique @db.Uuid
  graceMinutes         Int      @default(15)
  autoClockOutMinutes  Int?
  maxWorkHours         Int      @default(12)
  minBreakMinutes      Int      @default(0)
  maxBreakMinutes      Int      @default(60)
  overtimeAfterMinutes Int      @default(480)
  requireGpsLocation   Boolean  @default(false)
  gpsRadiusMeters      Int      @default(100)
  allowMobileClockIn   Boolean  @default(true)
  allowedMethods       String[] @default(["MANUAL", "QR_CODE", "MOBILE", "WEB"])
  isActive             Boolean  @default(true)
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now()) @db.Timestamptz
  updatedAt            DateTime @updatedAt @db.Timestamptz

  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("attendance_policies")
}

// ─── Shift ───────────────────────────────────────────────────────────────────

model Shift {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @db.Uuid
  name                 String    @db.VarChar(200)
  code                 String?   @db.VarChar(50)
  description          String?   @db.Text
  startTime            String    @db.VarChar(5)   // HH:mm (24-hour)
  endTime              String    @db.VarChar(5)   // HH:mm (24-hour)
  isNightShift         Boolean   @default(false)  // endTime is next calendar day
  workDays             Int[]     @default([1, 2, 3, 4, 5]) // ISO: 1=Mon..7=Sun
  graceMinutes         Int       @default(0)      // 0 = inherit from AttendancePolicy
  overtimeAfterMinutes Int?                       // null = inherit from AttendancePolicy
  colorCode            String?   @db.VarChar(7)
  isActive             Boolean   @default(true)
  metadata             Json      @default("{}")
  createdAt            DateTime  @default(now()) @db.Timestamptz
  updatedAt            DateTime  @updatedAt @db.Timestamptz
  deletedAt            DateTime? @db.Timestamptz

  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  breakRules           ShiftBreakRule[]
  assignments          ShiftAssignment[]
  rotationSlots        ShiftRotationSlot[]
  attendanceRecords    AttendanceRecord[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("shifts")
}

// ─── ShiftBreakRule ───────────────────────────────────────────────────────────

model ShiftBreakRule {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @db.Uuid
  shiftId         String    @db.Uuid
  name            String    @db.VarChar(100)
  breakType       BreakType @default(SHORT_BREAK)
  startOffsetMins Int       // minutes after shift start
  durationMinutes Int
  isPaid          Boolean   @default(false)
  isRequired      Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  shift           Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([tenantId])
  @@map("shift_break_rules")
}

// ─── ShiftAssignment ─────────────────────────────────────────────────────────

model ShiftAssignment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @db.Uuid
  userId     String    @db.Uuid
  shiftId    String?   @db.Uuid  // null when assignment is rotation-only
  rotationId String?   @db.Uuid
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date  // null = open-ended
  assignedBy String    @db.Uuid
  isActive   Boolean   @default(true)
  notes      String?   @db.Text
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift      Shift?         @relation(fields: [shiftId], references: [id])
  rotation   ShiftRotation? @relation(fields: [rotationId], references: [id])

  @@index([tenantId, userId])
  @@index([tenantId, shiftId])
  @@index([tenantId, userId, startDate])
  @@map("shift_assignments")
}

// ─── ShiftRotation ────────────────────────────────────────────────────────────

model ShiftRotation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  name        String    @db.VarChar(200)
  description String?   @db.Text
  cycleDays   Int       @default(14) // rotation repeats every N days
  startDate   DateTime  @db.Date     // reference epoch for cycle calculation
  isActive    Boolean   @default(true)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slots       ShiftRotationSlot[]
  assignments ShiftAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("shift_rotations")
}

// ─── ShiftRotationSlot ────────────────────────────────────────────────────────

model ShiftRotationSlot {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @db.Uuid
  rotationId String    @db.Uuid
  shiftId    String?   @db.Uuid  // null = day off in this slot
  dayOffset  Int       // 0 … cycleDays-1
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  rotation   ShiftRotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  shift      Shift?        @relation(fields: [shiftId], references: [id])

  @@unique([rotationId, dayOffset])
  @@index([rotationId])
  @@index([tenantId])
  @@map("shift_rotation_slots")
}
