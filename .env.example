# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=AMS
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ams_user:ams_password@localhost:5432/ams_db?schema=public
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ams_db
DATABASE_USER=ams_user
DATABASE_PASSWORD=ams_password
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_TTL=3600
REDIS_KEY_PREFIX=ams:

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=ams-platform
JWT_AUDIENCE=ams-clients

# ─── AWS Cognito ────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxx
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret
COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxx/.well-known/jwks.json

# ─── AWS S3 ─────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=ams-uploads-dev
S3_BUCKET_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRES=3600

# ─── AWS SNS / SES ──────────────────────────────────────────────────────────────
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789:ams-notifications
SES_FROM_EMAIL=noreply@yourdomain.com
SES_FROM_NAME=AMS Platform

# ─── Email ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_SECURE=false

# ─── Rate Limiting ──────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=10

# ─── MFA ────────────────────────────────────────────────────────────────────────
MFA_APP_NAME=AMS
MFA_TOTP_WINDOW=1

# ─── Encryption ─────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=your-32-char-encryption-key-here
ENCRYPTION_IV_LENGTH=16

# ─── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log

# ─── Health Check ───────────────────────────────────────────────────────────────
HEALTH_CHECK_PATH=/health
